# OpenRouter is used when this key is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI is the fallback provider when OPENROUTER_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional override. The default database is ../data/advisory.db.
# DATABASE_PATH=/absolute/path/to/advisory.db
