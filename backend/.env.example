# Enables the OpenAI Agents SDK identification and officer-report workflow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Prints labelled agent instructions, safe request context, and structured output to the backend terminal.
# It never prints image bytes or coordinates. Use only for local development.
AGENT_DEBUG_OUTPUT=false

# OpenRouter/chat completions are no longer used.
# Optional local storage overrides:
# DATABASE_PATH=/absolute/path/to/advisory.db
# OUTBREAK_EVIDENCE_DIR=/absolute/path/to/outbreak_evidence
