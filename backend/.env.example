# Enables the OpenAI Agents SDK identification and officer-report workflow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Prints labelled agent instructions, safe request context, and structured output to the backend terminal.
# It never prints image bytes or coordinates. Use only for local development.
AGENT_DEBUG_OUTPUT=false

# OpenRouter/chat completions are no longer used.
# OUTBREAK_EVIDENCE_DIR=/absolute/path/to/outbreak_evidence
# ENV=dev uses DATABASE_URL and stores consented crop photos on disk.
# ENV=prod requires all four SUPABASE_* settings below, with no local fallback.
ENV=dev
# Optional private fixtures on your machine only. Leave false for empty/UI setup.
# This setting is rejected in production and on Vercel.
LOAD_DEMO_SEED=false
# Development database URL. Use Supabase's direct or pooler URL from Connect.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Explicit local SQLite is available only if deliberately configured:
# DATABASE_URL=sqlite:////absolute/path/to/advisory.db

# Production only: PostgreSQL connection string, separate from the HTTPS URL.
SUPABASE_DATABASE_URL=
# HTTPS project URL from Connect (e.g. https://your-project.supabase.co).
SUPABASE_URL=
# Backend-only secret key from Settings > API Keys. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Create this PRIVATE bucket in Supabase Storage before using production uploads.
SUPABASE_STORAGE_BUCKET=disease-photos

# Required browser origin allowed to call this backend. It must exactly match
# the frontend URL, without a trailing slash.
# Set the deployed frontend origin in Vercel project environment variables.
FRONTEND_URL=http://localhost:3000
